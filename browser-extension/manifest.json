{
  "manifest_version": 3,
  "name": "BARQ Downloader",
  "version": "0.1.0",
  "description": "Official browser companion for BARQ Downloader (برق ڈاؤنلوڈر) — Speed at Every Click.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "storage",
    "activeTab"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BARQ Downloader"
  }
}
